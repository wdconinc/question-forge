# Required
API_TOKEN=changeme8          # 8-char alphanumeric token; share with browser users
LITELLM_MODEL=gemini-2.5-flash   # Default model id (browser users can override per-request); e.g.:
                                 #   gemini-2.5-flash | gemini-2.5-pro | claude-sonnet-5 | claude-opus-5 | claude-haiku-4-5
                                 # A "provider/" prefix (LiteLLM style, e.g. gemini/gemini-2.5-flash) is stripped automatically.

# Provider API keys — set the one(s) matching the models you want to offer.
# GET /models only advertises models whose provider key is configured.
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Optional
ANTHROPIC_MAX_TOKENS=8192    # max_tokens for Claude responses (required param on the Anthropic API)
GEMINI_MAX_OUTPUT_TOKENS=32768  # maxOutputTokens for Gemini responses; shared by thinking + the visible reply
GEMINI_THINKING_BUDGET=8192  # cap on Gemini's internal reasoning tokens, so a big request can't spend the
                             # whole GEMINI_MAX_OUTPUT_TOKENS budget thinking and reply with nothing (MAX_TOKENS)
MAX_CONTINUATIONS=1          # extra model calls spent finishing a turn that only asked for data it already had
PORT=8000
